      <p xml:space="preserve">
        <docTitle refersTo="#adoption">Adopted by the Security Council at its <inline name="adoptionMeeting" title="10220th">10220th meeting</inline>, on<docDate date="2026-09-11" refersTo="#adoptionDate">11 September 2026</docDate></docTitle>
