      <p xml:space="preserve">
        <docTitle refersTo="#resolutionNumber">Resolution 2833 (2026)</docTitle>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#adoption">Adopted by the Security Council at its <inline name="adoptionMeeting" title="10257th">10257th meeting</inline>, on<docDate date="2026-10-30" refersTo="#adoptionDate">30 October 2026</docDate></docTitle>
