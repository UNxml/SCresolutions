        <docTitle refersTo="#adoption">Adopted by the Security Council at its <inline name="adoptionMeeting" title="10204th">10204th meeting</inline>, on<docDate date="2026-07-29" refersTo="#adoptionDate">29 July 2026</docDate></docTitle>
