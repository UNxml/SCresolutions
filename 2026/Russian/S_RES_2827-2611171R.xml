      <p xml:space="preserve">
        <docTitle refersTo="#resolutionNumber">Резолюция 2827 (2026)</docTitle>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#adoption">принятая Советом Безопасности на его <inline name="adoptionMeeting" title="10204-м">10204-м заседании </inline><docDate date="2026-07-29" refersTo="#adoptionDate">29 июля 2026 года</docDate></docTitle>
      </p>
    </coverPage>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="italic">Совет Безопасности</span>,</p>
      </formula>
      <container name="ссылаясь" eId="container_2">
        <p xml:space="preserve">	<span class="italic">ссылаясь</span> на свою резолюцию <a href="https://docs.un.org/ru/S/RES/2745(2024)">2745 (2024)</a>,</p>
      </container>
      <container name="подтверждая" eId="container_3">
        <p xml:space="preserve">	<span class="italic">подтверждая </span>свою твердую приверженность суверенитету, независимости, единству и территориальной целостности Центральноафриканской Республики (ЦАР) и напоминая о важности принципов невмешательства, добрососедства и регионального сотрудничества,</p>
      </container>
      <container name="признавая" eId="container_4">
        <p xml:space="preserve">	<span class="italic">признавая</span> прогресс, достигнутый в ЦАР в отношении мирного процесса, выборов и распространения государственной власти,</p>
      </container>
      <container name="определяя" eId="container_5">
        <p xml:space="preserve">	<span class="italic">определяя</span>, что вооруженные группы, действующие в ЦАР, представляют угрозу международному миру и безопасности в этом регионе,</p>
      </container>
      <container name="действуя" eId="container_6">
        <p xml:space="preserve">	<span class="italic">действуя</span> на основании главы VII Устава Организации Объединенных Наций,</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_7" class="SingleTxt">
        <num>1.</num>
        <content eId="para_7__content">
          <p xml:space="preserve">	<span class="italic">постановляет</span> продлить до 31 июля 2027 года срок действия мер, изложенных или продленных в пунктах 2 и 4 резолюции <a href="https://docs.un.org/ru/S/RES/2745(2024)">2745 (2024)</a>, <span class="italic">постановляет </span>также продлить до 31 августа 2027 года мандат Группы экспертов, изложенный в пункте 6 резолюции <a href="https://docs.un.org/ru/S/RES/2745(2024)">2745 (2024)</a>, и <span class="italic">подтверждает</span> пункты 1, 3, 5 и 7‑12 резолюции <a href="https://docs.un.org/ru/S/RES/2745(2024)">2745 (2024)</a>, отмечая, что упомянутые даты представления среднесрочного и заключительного докладов Группы экспертов следует заменить на 31 января 2027 года и, соответственно, 15 июня 2027 года;</p>
        </content>
      </paragraph>
      <paragraph eId="para_8" class="SingleTxt">
        <num>2.</num>
        <content eId="para_8__content">
          <p xml:space="preserve">	<span class="italic">постановляет</span> продолжать активно заниматься этим вопросом.</p>
        </content>
      </paragraph>
    </mainBody>
