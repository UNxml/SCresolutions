    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="italic">Le Conseil de sécurité</span>,</p>
      </formula>
      <container name="Rappelant" eId="container_2">
        <p xml:space="preserve">	<span class="italic">Rappelant</span> sa résolution <a href="https://docs.un.org/fr/S/RES/2745(2024)">2745 (2024)</a>,</p>
      </container>
      <container name="Réaffirmant" eId="container_3">
        <p xml:space="preserve">	<span class="italic">Réaffirmant</span> son ferme attachement à la souveraineté, à l’indépendance, à l’unité et à l’intégrité territoriale de la République centrafricaine, et rappelant l’importance des principes de non-ingérence, de bon voisinage et de coopération régionale,</p>
      </container>
      <container name="Saluant" eId="container_4">
        <p xml:space="preserve">	<span class="italic">Saluant</span> les progrès accomplis en République centrafricaine en ce qui concerne le processus de paix, les élections et l’extension de l’autorité de l’État,</p>
      </container>
      <container name="Constatant" eId="container_5">
        <p xml:space="preserve">	<span class="italic">Constatant</span> que les groupes armés qui opèrent en République centrafricaine constituent une menace contre la paix et la sécurité internationales dans la région,</p>
      </container>
      <container name="Agissant" eId="container_6">
        <p xml:space="preserve">	<span class="italic">Agissant</span> en vertu du Chapitre VII de la Charte des Nations Unies,</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_7" class="SingleTxt">
        <num>1.</num>
        <content eId="para_7__content">
          <p xml:space="preserve">	<span class="italic">Décide</span> de proroger, jusqu’au 31 juillet 2027, les mesures énoncées ou prorogées aux paragraphes 2 et 4 de sa résolution <a href="https://docs.un.org/fr/S/RES/2745(2024)">2745 (2024)</a>, <span class="italic">décide</span> de proroger, jusqu’au 31 août 2027, le mandat du Groupe d’experts tel qu’il l’a énoncé au paragraphe 6 de sa résolution <a href="https://docs.un.org/fr/S/RES/2745(2024)">2745 (2024)</a>, et <span class="italic">réaffirme</span> les paragraphes 1, 3, 5 et 7 à 12 de sa résolution <a href="https://docs.un.org/fr/S/RES/2745(2024)">2745 (2024)</a>, en précisant que les références faites au rapport à mi‑parcours et au rapport final du Groupe d’experts doivent être actualisées de sorte que les dates soient le 31 janvier 2027 et le 15 juin 2027, respectivement ;</p>
        </content>
      </paragraph>
      <paragraph eId="para_8" class="SingleTxt">
        <num>2.</num>
        <content eId="para_8__content">
          <p xml:space="preserve">	<span class="italic">Décide</span> de rester activement saisi de la question.</p>
        </content>
      </paragraph>
    </mainBody>
