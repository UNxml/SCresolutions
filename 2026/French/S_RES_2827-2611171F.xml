      <p xml:space="preserve">
        <docTitle refersTo="#resolutionNumber">Résolution 2827 (2026)</docTitle>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#adoption">Adoptée par le Conseil de sécurité à sa <inline name="adoptionMeeting" title="10204e">10204e séance</inline>, le <docDate date="2026-07-29" refersTo="#adoptionDate">29 juillet 2026</docDate></docTitle>
      </p>
