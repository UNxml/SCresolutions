    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن مجلس الأمن</span>،</p>
      </formula>
      <container name="إذ يؤكد من جديد" eId="container_2">
        <p xml:space="preserve">	<span class="bold italic">إذ يؤكد من جديد</span> جميع القرارات السابقة المتعلقة بهايتي، بما في ذلك القرار <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a> الذي أذن بإنشاء قوة قمع العصابات،</p>
      </container>
      <container name="وإذ يعترف" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يعترف</span> بالتقدم الذي أُحرز حتى الآن في نشر قوة قمع العصابات من قبل كل من مكتب الأمم المتحدة لتقديم الدعم في هايتي وفريق الشركاء الدائم، وبجهودهما المستمرة بالشراكة مع السلطات الهايتية من أجل استعادة الأمن في هايتي، وإذ يرحب بالمساهمات التي قدمتها الدول الأعضاء لقوة قمع العصابات وصندوق الأمم المتحدة الاستئماني،</p>
      </container>
      <container name="وإذ يؤكد من جديد" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يؤكد من جديد</span> دعمه لإيجاد حل شامل ودائم بقيادة هايتية، يعالج الأسباب الرئيسية لحالة عدم الاستقرار الحالية والأزمات المتعددة الأبعاد التي تشهدها هايتي، وإذ يشدد على أهمية تهيئة الظروف الأمنية المواتية لإجراء انتخابات حرة ونزيهة، </p>
      </container>
      <container name="وإذ يشدد" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشدد</span> على أن السلطات الهايتية هي المسؤولة في المقام الأول عن توفير الأمن وضمان الاستقرار واحترام سيادة القانون وحقوق الإنسان، وعن حماية المدنيين في جميع أنحاء أراضي هايتي، وعن التصدي للأسباب البنيوية لعدم الاستقرار، بما في ذلك ببذل الجهود من أجل التصدي للفساد المترسّخ وإجراء إصلاحات أساسية لنُظم الحكم في هايتي، والتصدي لتدفق الأسلحة غير المشروعة إلى البلد، </p>
      </container>
      <container name="وإذ يشير" eId="container_6">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشير</span> إلى أن قوة قمع العصابات مخولة بتنفيذ ولايتها في إطار الامتثال الصارم للقانون الدولي، بما في ذلك القانون الدولي لحقوق الإنسان، حسب الاقتضاء، وإذ يشير كذلك إلى طلب المجلس بأن تكفل الدول الأعضاء المشارِكة في قوة قمع العصابات اتقيُّد وحداتها بأعلى معايير الشفافية والسلوك والانضباط، </p>
      </container>
      <container name="وإذ يقر ببالغ القلق" eId="container_7">
        <p xml:space="preserve">	<span class="bold italic">وإذ يقر ببالغ القلق</span> بأن نسبة كبيرة من أفراد العصابات هم أطفال، بسبب أعمال التجنيد المنتظمة، بما فيها الحيل القسرية والإجبارية، التي تستهدف عمداً أكثر المجتمعات ضعفاً، وإذ يؤكد أهمية بروتوكول التسليم لعام 2024 المبرم بين الأمم المتحدة وحكومة هايتي باعتباره خطوة هامة نحو حماية الأطفال المحتجزين بسبب ارتباطهم المزعوم بالجماعات المسلحة؛ وإذ يسلِّم بالحاجة إلى برامج لإعادة الإدماج تكون مصمَّمة خصيصاً لهذا الغرض، وإلى الدعم النفسي - الاجتماعي، وإتاحة التعليم للأطفال الذين كانوا مرتبطين سابقاً بالعصابات،</p>
      </container>
      <container name="وإذ يقرر" eId="container_8">
        <p xml:space="preserve">	<span class="bold italic">وإذ يقرر</span> أن الحالة في هايتي لا تزال تشكل خطراً يتهدد السلام والأمن الدوليين والاستقرار في المنطقة،</p>
      </container>
      <container name="وإذ يتصرف" eId="container_9">
        <p xml:space="preserve">	<span class="bold italic">وإذ يتصرف</span> بموجب الفصل السابع من ميثاق الأمم المتحدة،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_10" class="SingleTxt">
        <num>1 -</num>
        <content eId="para_10__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر تمديد</span> ولاية قوة قمع العصابات لمدة ستة أشهر، أي حتى 31 آذار/مارس 2027، ويطلب إلى الأمين العام أن يواصل تقديم الدعم اللوجستي والعملياتي من خلال مكتب الأمم المتحدة لتقديم الدعم في هايتي، في إطار الامتثال التام للقرار <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a>؛ </p>
        </content>
      </paragraph>
      <paragraph eId="para_11" class="SingleTxt">
        <num>2 -</num>
        <content eId="para_11__content">
          <p xml:space="preserve">	<span class="bold italic">تطلب</span> إلى الأمين العام أن يقدم إلى مجلس الأمن، كل ستة أشهر، في إطار تقاريره الدورية عن هايتي، تقريراً عن التقدم الذي تحرزه السلطات الهايتية في تحقيق المعايير المرجعية عملا بالفقرة 24 من القرار <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a>؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_13" class="SingleTxt">
        <num>3 -</num>
        <content eId="para_13__content">
          <p xml:space="preserve">	<span class="bold italic">يحيط علماً</span> بالاتفاق المبرم بين حكومة هايتي وقوة قمع العصابات، الموقع عليه في 27 تموز/يوليه 2026، والذي يؤكد الشخصية القانونية لقوة قمع العصابات، فضلاً عن ترتيبات أخرى تمنح القوة وأفرادها المركز والحماية اللازمين لمواصلة ممارسة مهامهم بشكل مستقل، ويشجع الدول الأعضاء على اتخاذ التدابير اللازمة، حسب الاقتضاء، للاعتراف بالمركز القانوني لقوة قمع العصابات ومنح القوة وأفرادها الامتيازات والحصانات اللازمة لمواصلة ممارسة مهامهم بشكل مستقل؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_16" class="SingleTxt">
        <num>4 -</num>
        <content eId="para_16__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر</span> أن يبقي المسألة قيد نظره الفعلي.</p>
        </content>
      </paragraph>
    </mainBody>
  </statement>
