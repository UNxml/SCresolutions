      <p xml:space="preserve">
        <docTitle refersTo="#resolutionNumber">القرار 2827 (2026)</docTitle>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#adoption">الذي اتخذه مجلس الأمن في <inline name="adoptionMeeting" title="10204">جلسته 10204</inline>، المعقودة في <docDate date="2026-07-29" refersTo="#adoptionDate">29 تموز/يوليه 2026</docDate></docTitle>
      </p>
    </coverPage>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن مجلس الأمن</span>،</p>
      </formula>
      <container name="إذ يشير" eId="container_2">
        <p xml:space="preserve">
          <span class="bold italic">	إذ يشير</span> إلى قراره <a href="https://docs.un.org/ar/S/RES/2745(2024)">2745 (2024</a><a href="https://docs.un.org/ar/S/RES/2745(2024)">)</a>،</p>
      </container>
      <container name="وإذ يؤكد من جديد" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يؤكد من جديد</span> التزامه القوي بسيادة جمهورية أفريقيا الوسطى واستقلالها ووحدتها وسلامتها الإقليمية، وإذ يشير إلى أهمية مبادئ عدم التدخل وحسن الجوار والتعاون الإقليمي،</p>
      </container>
      <container name="وإذ يسلّم" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يسلّم</span> بالتقدم الذي أُحرز في جمهورية أفريقيا الوسطى فيما يتعلق بعملية السلام والانتخابات وبسط سلطة الدولة،</p>
      </container>
      <container name="وإذ يقرر" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يقرر</span> أن الجماعات المسلحة العاملة في جمهورية أفريقيا الوسطى تشكل خطرا يهدد السلام والأمن الدوليين في المنطقة،</p>
      </container>
      <container name="وإذ يتصرف" eId="container_6">
        <p xml:space="preserve">	<span class="bold italic">وإذ يتصرف</span> بموجب الفصل السابع من ميثاق الأمم المتحدة،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_7" class="SingleTxt">
        <num>1 -</num>
        <content eId="para_7__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر</span> أن يمدد حتى 31 تموز/يوليه 2027 التدابير المبينة أو الممددة في الفقرتين 2 و 4 من القرار <a href="https://docs.un.org/ar/S/RES/2745(2024)">2745 (2024</a><a href="https://docs.un.org/ar/S/RES/2745(2024)">)</a>، <span class="bold italic">ويقرر</span> أن يمدد حتى 31 آب/أغسطس 2027 ولاية فريق الخبراء على النحو المبين في الفقرة 6 من القرار <a href="https://docs.un.org/ar/S/RES/2745(2024)">2745 (2024</a><a href="https://docs.un.org/ar/S/RES/2745(2024)">)</a>، <span class="bold italic">ويعيد تأكيد</span> الفقرات 1 و 3 و 5 ومن 7 إلى 12 من القرار <a href="https://docs.un.org/ar/S/RES/2745(2024)">2745 (2024)</a>، مشيرا إلى ضرورة تحديث الإشارة إلى موعدي تقديم تقرير منتصف المدة والتقرير النهائي لفريق الخبراء ليصبحا 31 كانون الثاني/يناير 2027 و 15 حزيران/يونيه 2027، على التوالي؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_8" class="SingleTxt">
        <num>2 -</num>
        <content eId="para_8__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر</span> أن يبقي المسألة قيد نظره الفعلي.</p>
        </content>
      </paragraph>
