    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن مجلس الأمن،</span>
        </p>
      </formula>
      <container name="إذ يعيد تأكيد" eId="container_2">
        <p xml:space="preserve">	<span class="bold italic">إذ يعيد تأكيد </span>التزامه القوي بسيادة هايتي واستقلالها وسلامتها الإقليمية ووحدتها،</p>
      </container>
      <container name="وإذ يشير" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشير</span> إلى جميع قراراته السابقة بشأن هايتي، ولا سيما قراراته <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a> و <a href="https://docs.un.org/ar/S/RES/2700(2023)">2700 (2023)</a> و <a href="https://docs.un.org/ar/S/RES/2752(2024)">2752 (2024)</a> و <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a> و <a href="https://docs.un.org/ar/S/RES/2794(2025)">2794 (2025)</a> و <a href="https://docs.un.org/ar/S/RES/2829(2026)">2829 (2026)</a>،</p>
      </container>
      <container name="وإذ يعرب عن بالغ القلق" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يعرب عن بالغ القلق</span> إزاء الارتفاع الشديد جدا في مستويات عنف العصابات وغيره من الأنشطة الإجرامية في هايتي، بما في ذلك عمليات الاختطاف والاتجار بالبشر وتهريب المهاجرين وجرائم القتل والعنف الجنسي، بما يشمل الاغتصاب والاسترقاق الجنسي، إضافة إلى ما تقوم به العصابات من قتل للأطفال وتشويههم واختطافهم وارتكاب العنف الجنسي ضدهم وتجنيدهم، فضلاً عن استمرار إفلات الجناة ومعاونيهم ومموليهم من العقاب،</p>
      </container>
      <container name="وإذ يعرب عن بالغ القلق" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يعرب عن بالغ القلق</span> من أن الاتجار غير المشروع بالأسلحة والذخيرة وتحويلها إلى العصابات المسلحة في هايتي ما زال يؤجج هذا العنف، ويقوض سيادة القانون واحترام حقوق الإنسان، ويمكن أن يحول دون تقديم المساعدة الإنسانية، الأمر الذي يمكن أن تترتب عليه عواقب سلبية إنسانية واجتماعية واقتصادية واسعة النطاق وعلى الصعيد الإقليمي، وإذ يحث الدول الأعضاء على اتخاذ تدابير عاجلة وحاسمة من أجل التنفيذ التام لحظر توريد الأسلحة،</p>
      </container>
      <container name="وإذ يشجع" eId="container_6">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشجع </span>الدول الأعضاء على دعم استراتيجية التدخل لعام 2026 التي وضعتها اللجنة الوطنية لنزع السلاح وتفكيك العصابات المسلحة وإعادة الإدماج، بما في ذلك من خلال تقديم الدعم لصندوق الأمم المتحدة لثمار السلام في هايتي، وعلى بناء قدرات الشرطة الوطنية الهايتية والقوات المسلحة الهايتية،</p>
      </container>
      <container name="وإذ يسلّم" eId="container_7">
        <p xml:space="preserve">	<span class="bold italic">وإذ يسلّم </span>بالحاجة إلى صون الإجراءات القانونية الواجبة، وإلى ضمان إجراءات عادلة وواضحة تُرفع بموجبها من قائمة الجزاءات أسماء الأفراد والكيانات المدرجة عملا بالقرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a> والقرارات اللاحقة، وإذ يرحب بتعيين مركز التنسيق المعني برفع الأسماء من القائمة، وإذ يسلم كذلك في الوقت نفسه بدور جزاءات الأمم المتحدة في تسوية النزاعات وصون السلام والأمن الدوليين،</p>
      </container>
      <container name="وإذ يقرر" eId="container_8">
        <p xml:space="preserve">
          <span class="bold italic">	وإذ يقرر </span>أن الحالة في هايتي لا تزال تشكل تهديدا للسلام والأمن الدوليين في المنطقة،</p>
      </container>
      <container name="وإذ يتصرف" eId="container_9">
        <p xml:space="preserve">	<span class="bold italic">وإذ يتصرف </span>بموجب الفصل السابع من ميثاق الأمم المتحدة،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_10" class="H23">
        <subheading>		حظر السفر، وتجميد الأصول، وحظر توريد الأسلحة</subheading>
      </paragraph>
      <paragraph eId="para_11" class="SingleTxt">
        <num>1 -</num>
        <content eId="para_11__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر </span>أن يجدد لمدة سنة واحدة من تاريخ اتخاذ هذا القرار التدابير المفروضة بموجب الفقرات 3 و 4 و 5 و 6 و 7 و 8 و 9 من القرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a>، والتي سبق تمديدها في القرار <a href="https://docs.un.org/ar/S/RES/2794(2025)">2794</a><a href="https://docs.un.org/ar/S/RES/2794(2025)"> </a><a href="https://docs.un.org/ar/S/RES/2794(2025)">(2025)</a>، ويؤكد من جديد القرار <a href="https://docs.un.org/ar/S/RES/2664(2022)">2664 (2022)</a>، ويؤكد استمرار سريان الفقرتين 15 و 16 من القرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a>، ويقرر أن الأعمال المبينة في الفقرة 15 من القرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a> تشمل الانخراط في أنشطة تزعزع استقرار هايتي من خلال استغلال الموارد الطبيعية أو الاتجار بها بصورة غير مشروعة؛ <span class="bold italic">ويشجع كذلك</span> الحكومة الهايتية على اعتماد مرسوم ينظم استغلالَ أسماك فرخ الأنقليس والنشاطَ التجاري ذا الصلة؛ <span class="bold italic">ويقرر كذلك</span> تمديد التدابير المفروضة بموجب الفقرة 2 من القرار <a href="https://docs.un.org/ar/S/RES/2794(2025)">2794 (2025)</a> لمدة سنة واحدة من تاريخ اتخاذ هذا القرار؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_12" class="SingleTxt">
        <num>2 -</num>
        <content eId="para_12__content">
          <p xml:space="preserve">	<span class="bold italic">يعرب عن القلق </span>إزاء التقارير التي تفيد بحدوث استيلاء غير مشروع على الموارد العامة واختلاسها وتحويل وجهتها، لما يشكله ذلك من خطر على السلام والأمن والاستقرار في هايتي، <span class="bold italic">ويؤكد</span>، في هذا السياق، أن الأفراد الذين يتورطون، بصورة مباشرة أو غير مباشرة، في الأنشطة الإجرامية وأعمال العنف التي تشارك فيها الجماعات المسلحة والشبكات الإجرامية التي تشجع على العنف، أو يدعمون تلك الأنشطة والأعمال، أو الذين يقومون بأنشطة تزعزع استقرار هايتي من خلال استغلال الموارد الطبيعية أو الاتجار بها بصورة غير مشروعة، يجوز إدراج أسمائهم على قائمة الأشخاص الخاضعين لتدابير حظر السفر والتدابير المالية؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_14" class="SingleTxt">
        <num>3 -</num>
        <content eId="para_14__content">
          <p xml:space="preserve">	<span class="bold italic">يؤكد من جديد قراره</span> أن تتخذ الدول الأعضاء الخطوات المناسبة لمنع الاتجار غير المشروع بالأسلحة والأعتدة ذات الصلة وتحويل وجهتها في هايتي، بما في ذلك من خلال تعزيز ما لديها من آليات لمراقبة الحدود؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_17" class="SingleTxt">
        <num>4 -</num>
        <content eId="para_17__content">
          <p xml:space="preserve">	<span class="bold italic">يدعو </span>الدول الأعضاء التي تنقل الأسلحة النارية والذخيرة والأعتدة ذات الصلة إلى السلطات الهايتية المعنية، سواء عن طريق البيع أو التبرع، إلى تقديم الدعم لتلك السلطات في تعزيز الأمن المادي وإدارة مخزونات الأسلحة والضوابط اللاحقة للتسليم، وذلك للتخفيف من خطر تحويل وجهة الأسلحة؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_21" class="SingleTxt">
        <num>5 -</num>
        <content eId="para_21__content">
          <p xml:space="preserve">	<span class="bold italic">يشجع </span>على زيادة التنسيق فيما بين اللجنة وفريق الخبراء التابع لها ومكتب الأمم المتحدة المتكامل في هايتي ومكتب الأمم المتحدة المعني بالمخدرات والجريمة وقوة قمع العصابات ومكتب الأمم المتحدة لتقديم الدعم في هايتي، والأطر الإقليمية الأخرى، بشأن رصد وتيسير تنفيذ نظام الجزاءات، بما في ذلك حظر توريد الأسلحة، وبشأن تقديم الدعم للسلطات الهايتية بهدف تعزيز قدرات الشرطة الوطنية الهايتية والقوات المسلحة الهايتية وسلطات الحدود والجمارك الهايتية، من أجل الحد من تدفقات الأسلحة غير المشروعة، ويشجع كذلك على عقد جلسات إحاطة دورية لعموم أعضاء الأمم المتحدة من أجل تبادل المعلومات والتوعية؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_26" class="SingleTxt">
        <num>6 -</num>
        <content eId="para_26__content">
          <p xml:space="preserve">	<span class="bold italic">يدعو </span>السلطات الهايتية إلى تعزيز قدرات الشرطة الوطنية الهايتية والقوات المسلحة الهايتية في مجال إدارة الأسلحة والذخائر، بما في ذلك عن طريق تحسين عمليات وسم محتويات مخزوناتها الوطنية من الأسلحة والذخائر المحجوزة وحفظ سجلات هذه المحجوزات وتخزينها والتخلص منها، وإلى تعزيز المراقبة الحدودية والجمركية، بما يتماشى مع الفقرة 1 (ه) من القرار <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a>؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_32" class="SingleTxt">
        <num>7 -</num>
        <content eId="para_32__content">
          <p xml:space="preserve">	<span class="bold italic">يؤكد </span>أنه، وتماشيا مع الفقرة 1 (ه) من القرار <a href="https://docs.un.org/ar/S/RES/2793(2025)">2793 (2025)</a>، ينبغي لقوة قمع العصابات أن تدعم الشرطة الوطنية الهايتية والقوات المسلحة الهايتية في تسجيل الأسلحة والذخائر غير المشروعة وغيرها من الأعتدة غير المشروعة التي تُصادَر في إطار العمليات الهجومية أو في سياق تنفيذ ولايتها، والتخلص منها، حسب الاقتضاء؛ <span class="bold italic">ويدعو كذلك</span> قوة قمع العصابات إلى إبلاغ فريق الخبراء المُنشأ عملا بالقرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a> بأي تحويل لوجهة الأسلحة والذخائر، بما في ذلك حالات ضياع الأسلحة أو سرقتها؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_33" class="H23">
        <subheading>		لجنة الجزاءات وفريق الخبراء</subheading>
      </paragraph>
      <paragraph eId="para_34" class="SingleTxt">
        <num>8 -</num>
        <content eId="para_34__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر</span> أن ولاية اللجنة، على النحو المحدد في الفقرة 19 من القرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a>، تسري على التدابير المفروضة في هذا القرار؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_35" class="SingleTxt">
        <num>9 -</num>
        <content eId="para_35__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر</span> تمديد ولاية فريق الخبراء، بصيغتها المحددة في الفقرة 21 من القرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653</a><a href="https://docs.un.org/ar/S/RES/2653(2022)"> </a><a href="https://docs.un.org/ar/S/RES/2653(2022)">(2022)</a>، لمدة 13 شهرا اعتبارا من تاريخ اتخاذ هذا القرار، ويقرر كذلك أن تنطبق هذه الولاية أيضا فيما يتعلق بالتدابير المفروضة في هذا القرار؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_37" class="SingleTxt">
        <num>10 -</num>
        <content eId="para_37__content">
          <p xml:space="preserve">	<span class="bold italic">يوعز</span> إلى اللجنة أن تعجل بالنظر في تحديث قائمة أسماء الكيانات والأفراد المحددة عملا بالقرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a>، آخذة في الاعتبار التقارير المقدمة من فريق الخبراء، بما في ذلك إضافة أسماء الأفراد والكيانات الذين يتصرفون في انتهاك لحظر توريد الأسلحة المفروض بموجب هذا القرار إلى القائمة؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_40" class="SingleTxt">
        <num>11 -</num>
        <content eId="para_40__content">
          <p xml:space="preserve">	<span class="bold italic">يطلب </span>أن يوافي فريقُ الخبراء مجلسَ الأمن، بعد مناقشة الأمر مع اللجنة، بتقرير مرحلي بحلول 28 آذار/مارس 2027، وبتقرير نهائي في موعد أقصاه 1 أيلول/سبتمبر 2027، وبتحديثات دورية في أثناء تلك المدة، ويؤكد من جديد ولاية الفريق المتمثلة في جمع المعلومات المتعلقة بتنفيذ التدابير المقررة في هذا القرار ودراستها وتحليلها؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_44" class="SingleTxt">
        <num>12 -</num>
        <content eId="para_44__content">
          <p xml:space="preserve">	<span class="bold italic">يطلب </span>من جميع الدول الأعضاء إبلاغ فريق الخبراء واللجنة بانتظام وفي الوقت المناسب بما تتخذه من إجراءات ملموسة لتنفيذ هذا القرار التنفيذ التام، وذلك لتيسير عمل فريق الخبراء في مجال الإبلاغ وتبادل أفضل الممارسات، <span class="bold italic">ويطلب </span>من فريق الخبراء أن يُبلغ عن تنفيذ هذا القرار وعن مدى فعاليته في تقاريره المنتظمة التي يقدمها إلى مجلس الأمن، <span class="bold italic">ويطلب كذلك </span>من جميع الأطراف، والدول الأعضاء، إضافة إلى المنظمات الدولية والإقليمية ودون الإقليمية ومكتب الأمم المتحدة المتكامل في هايتي ومكتب الأمم المتحدة لتقديم الدعم في هايتي وقوة قمع العصابات، أن تتعاون وتتبادل المعلومات مع فريق الخبراء على النحو المناسب، بما في ذلك من خلال تيسير وصول فريق الخبراء إلى الأشخاص والوثائق والمواقع بطريقة آمنة لكي يتسنى للفريق أن يضطلع بالولاية المنوطة به؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_45" class="H23">
        <subheading>		الاستعراض</subheading>
      </paragraph>
      <paragraph eId="para_46" class="SingleTxt">
        <num>13 -</num>
        <list eId="para_46_list">
          <intro eId="para_46_list_intro">
            <p xml:space="preserve">	<span class="bold italic">يؤكد </span>أنه سيبقي الحالة في هايتي قيد الاستعراض المستمر وأنه سيكون على استعداد لاستعراض مدى ملاءمة التدابير الواردة في هذا القرار، بما في ذلك تعزيز التدابير أو تعديلها أو تعليقها أو رفعها، حسبما تدعو إليه الحاجة في أي وقت في ضوء التقدم المحرز فيما يتعلق بالنقاط المرجعية الرئيسية التالية:</p>
          </intro>
          <point eId="para_46_list_point_أ">
            <num>(أ)</num>
            <content eId="para_46_list_point_أ_content">
              <p xml:space="preserve">	عندما تطور السلطات الهايتية القدرات الكافية في مجالي القضاء وسيادة القانون للتصدي للجماعات المسلحة والأنشطة المتصلة بالجريمة؛</p>
            </content>
          </point>
          <point eId="para_46_list_point_ب">
            <num>(ب)</num>
            <content eId="para_46_list_point_ب_content">
              <p xml:space="preserve">	الحد تدريجيا من حجم العنف الذي ترتكبه الجماعات المسلحة والشبكات الإجرامية، بما في ذلك عدد جرائم القتل العمد وعمليات الاختطاف وحوادث العنف الجنسي، حسبما يقاس سنويا، بدءا من الفترة الأولية التي تمتد على مدى اثني عشر شهرا من تاريخ اتخاذ هذا القرار؛</p>
            </content>
          </point>
          <point eId="para_46_list_point_ج">
            <num>(ج)</num>
            <content eId="para_46_list_point_ج_content">
              <p xml:space="preserve">	الانخفاض التدريجي في عدد حوادث الاتجار غير المشروع بالأسلحة وتحويل وجهتها، وفي التدفقات المالية غير المشروعة الناشئة عن ذلك الاتجار، بسبل منها زيادة عمليات حجز الأسلحة من حيث عددها وحجمها؛</p>
            </content>
          </point>
        </list>
      </paragraph>
      <paragraph eId="para_47" class="SingleTxt">
        <num>14 -</num>
        <content eId="para_47__content">
          <p xml:space="preserve">	<span class="bold italic">يطلب</span> إلى الأمين العام في هذا الصدد أن يجري، بتنسيق وثيق مع فريق الخبراء، وفي موعد أقصاه 1 أيلول/سبتمبر 2027، تقييما للتقدم المحرز فيما يتعلق بالنقاط المرجعية الرئيسية المحددة في الفقرة أعلاه؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_49" class="SingleTxt">
        <num>15 -</num>
        <content eId="para_49__content">
          <p xml:space="preserve">	<span class="bold italic">يطلب </span>من السلطات الهايتية أن تبلغ اللجنة المنشأة عملا بالقرار <a href="https://docs.un.org/ar/S/RES/2653(2022)">2653 (2022)</a> بشأن هايتي، في موعد أقصاه اثنا عشر شهرا من تاريخ اتخاذ هذا القرار، ثم سنويا بعد ذلك، بالتقدم المحرز في استيفاء النقاط المرجعية الرئيسية الواردة في الفقرة 16 من هذا القرار، ويحث السلطات الهايتية على إبلاغ لجنة الأمم المتحدة للجزاءات المتعلقة بهايتي وإحاطتها سنويا بالتقدم المحرز في تنفيذ الجزاءات، بما في ذلك الإجراءات التشريعية والتنظيمية وإجراءات الإنفاذ، وكذلك بالتحديات الملازمة لذلك؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_52" class="SingleTxt">
        <num>16 -</num>
        <content eId="para_52__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر </span>أن يبقي المسألة قيد نظره الفعلي.</p>
        </content>
      </paragraph>
    </mainBody>
  </statement>
