    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن مجلس الأمن</span>
          <span class="italic">،</span>
        </p>
      </formula>
      <container name="إذ يؤكد من جديد" eId="container_2">
        <p xml:space="preserve">	<span class="bold italic">إذ يؤكد من جديد</span> التزامه بدعم كولومبيا في سبيل إحلال السلام والعدل والأمن،</p>
      </container>
      <container name="وإذ يعترف" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يعترف</span> بالتزام شعب جمهورية كولومبيا الدستوري بعملية السلام، وإذ يشير إلى قراراته المتخذة في هذا الصدد،</p>
      </container>
      <container name="وإذ يرحب" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يرحب</span> بالتقدم المحرز نحو إحلال السلام في كولومبيا، وإذ يسلِّم بالتحديات المستمرة في كولومبيا في هذا الصدد، وإذ يستذكر الجهود المبذولة منذ اعتماد الاتفاق النهائي الموقع في عام 2016 لإنهاء النزاع وإحلال سلام مستقر ودائم (الاتفاق النهائي)، وإذ يستذكر أيضاً الجهود المبذولة من أجل معالجة العوامل البنيوية الكامنة وراء النزاع، وإذ يشيد بالجهود المبذولة حتى الآن من قِبل قوات الأمن والمجتمع المدني، بما في ذلك النساء والشباب، وإذ يحث مؤسسات الدولة المعنية على بذل المزيد من الجهود، وإذ يشجع جميع أصحاب المصلحة على العمل معاً من أجل الاستفادة من الجهود المبذولة حتى الآن والتصدي للتحديات المستمرة،</p>
      </container>
      <container name="وإذ يلاحظ" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يلاحظ</span> على وجه الخصوص استمرار العنف في المناطق المتضرِّرة من النزاع الذي يمسّ بجميع المجتمعات المحلية، بما في ذلك العنف الجنسي والعنف الجنساني اللذان يستهدفان النساء والفتيات، وإذ يشير إلى الأثر المتباين للنزاع على جميع المجتمعات المحلية الضعيفة، بما في ذلك النساء والأطفال والأشخاص المنتمون إلى المجتمعات المحلية المهمشة،</p>
      </container>
      <container name="وإذ يسلِّم" eId="container_6">
          <p xml:space="preserve">	<span class="bold italic">وإذ يسلِّم</span> بديناميات النزاع المتغيِّرة في كولومبيا، <span class="bold italic">وإذ يشدد</span> على أهمية تعزيز وجود الدولة والتنمية الإقليمية في جميع المناطق المتضرِّرة من النزاع، بسبل منها تنفيذ الاتفاق النهائي والسياسات الأمنية التكميلية وبذل الجهود من أجل التصدي لإنتاج المخدرات غير المشروعة والاتجار بها وللتعدين غير القانوني،</p>
      </container>
      <container name="وإذ يقرّ" eId="container_7">
        <p xml:space="preserve">	<span class="bold italic">وإذ يقرّ</span> بالتزام الحكومة باستعادة سيطرة الدولة على إقليمها وببناء وجود الدولة في مختلف المناطق، <span class="bold italic">وإذ يؤكد</span> أهمية الوجود الميداني لبعثة الأمم المتحدة للتحقق، لا سيما في المناطق المتضررة من النزاع، من أجل دعم التواصل مع السلطات وهذه المجتمعات المحلية،</p>
      </container>
      <container name="وإذ يؤكد من جديد" eId="container_8">
        <p xml:space="preserve">	<span class="bold italic">وإذ يؤكد من جديد</span> امتلاك كولومبيا القرار السيادي في تنفيذ الاتفاق النهائي،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_9" class="SingleTxt">
        <num>1 -</num>
        <content eId="para_9__content">
          <p xml:space="preserve">
            <span class="bold italic">	يقرر</span> تمديد ولاية بعثة الأمم المتحدة للتحقق في كولومبيا حتى 31 تشرين الأول/ أكتوبر 2027، مع التركيز على وظيفتها الأساسية المتمثّلة في دعم التحقق ورصد تنفيذ الاتفاق النهائي فيما يتعلق بالقرار <a href="https://docs.un.org/ar/S/RES/2366(2017)">2366 (2017)</a>؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_10" class="SingleTxt">
        <num>2 -</num>
        <content eId="para_10__content">
          <p xml:space="preserve">
            <span class="bold italic">	يطلب</span> إلى الأمين العام أن يكفل التنسيق وتحقيق أوجه الكفاءة، بما في ذلك عن طريق ضمان أن تُنفَّذ الأنشطة الأخرى في البلد بمعرفة كيان منظومة الأمم المتحدة الأكثر ملاءمة؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_12" class="SingleTxt">
        <num>3 -</num>
        <content eId="para_12__content">
          <p xml:space="preserve">
            <span class="bold italic">	يعرب</span> عن استعداده لمواصلة العمل مع كولومبيا.</p>
        </content>
      </paragraph>
    </mainBody>
  </statement>
