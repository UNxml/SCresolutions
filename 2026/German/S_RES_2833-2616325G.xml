      <p class="upperRight">
        <docNumber refersTo="#symbol">S/RES/2833 (2026)</docNumber>
      </p>
      <p class="upperLeft">
        <img src="logo-un.jpg"></img>
        <docAuthority refersTo="#issuingBody" class="rightBig">Sicherheitsrat</docAuthority>
      </p>
      <p>
        <docStatus refersTo="#generalDistribution" class="rightSmall">Verteilung: Allgemein</docStatus>
      </p>
      <p>
        <docDate date="2026-10-30" class="rightSmall" refersTo="#dateOfIssuance">30. Oktober 2026</docDate>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#resolutionNumber">Resolution 2833 (2026)</docTitle>
      </p>
      <p xml:space="preserve">
        <docTitle refersTo="#adoption">verabschiedet auf der <inline name="adoptionMeeting" title="10257.">10257. Sitzung des Sicherheitsrats </inline>am <docDate date="2026-10-30" refersTo="#adoptionDate">30. Oktober 2026</docDate></docTitle>
      </p>
    </coverPage>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="italic">Der Sicherheitsrat</span>,</p>
      </formula>
      <container name="in Bekräftigung" eId="container_2">
        <p xml:space="preserve">	<span class="italic">in Bekräftigung</span> seines Bekenntnisses zur Unterstützung Kolumbiens bei der Herbeiführung von Frieden, Gerechtigkeit und Sicherheit,</p>
      </container>
      <container name="in Anerkennung" eId="container_3">
        <p xml:space="preserve">	<span class="italic">in Anerkennung</span> des verfassungsrechtlichen Bekenntnisses der Bevölkerung der Republik Kolumbien zum Friedensprozess und unter Hinweis auf seine einschlägigen Resolutionen,</p>
      </container>
      <container name="unter Begrüßung" eId="container_4">
        <p xml:space="preserve">	<span class="italic">unter Begrüßung</span> der Fortschritte, die auf dem Weg zum Frieden in Kolumbien erzielt wurden, unter Kenntnisnahme der anhaltenden Herausforderungen, denen sich Kolumbien in dieser Hinsicht gegenübersieht, unter Hinweis auf die Bemühungen, die seit der Annahme des Endgültigen Abkommens zur Beendigung des Konflikts und zum Aufbau eines stabilen und dauerhaften Friedens („Endgültiges Abkommen“) von 2016 unternommen wurden, sowie unter Hinweis auf die Anstrengungen zur Beseitigung der strukturellen Faktoren, die dem Konflikt zugrunde liegen, in Würdigung der beachtlichen Anstrengungen, die diesbezüglich bislang von den Sicherheitskräften und der Zivilgesellschaft, darunter Frauen und junge Menschen, unternommen wurden, mit der nachdrücklichen Forderung nach verstärkten Bemühungen seitens maßgeblicher staatlicher Institutionen und alle Interessenträger zur Zusammenarbeit ermutigend, um auf bisherigen Anstrengungen aufzubauen und anhaltende Herausforderungen zu bewältigen,</p>
      </container>
      <container name="in Anbetracht" eId="container_5">
          <p xml:space="preserve">	insbesondere <span class="italic">in Anbetracht </span>der anhaltenden Gewalt in vom Konflikt betroffenen Gebieten, die alle Gemeinschaften betrifft und auch sexuelle und geschlechtsspezifische Gewalt umfasst, die gegen Frauen und Mädchen gerichtet ist, und daran erinnernd, dass der Konflikt unverhältnismäßig starke Auswirkungen auf alle schutzbedürftigen Gemeinschaften hat, darunter Frauen, Kinder und Angehörige marginalisierter Gemeinschaften,</p>
      </container>
      <container name="feststellend" eId="container_6">
        <p xml:space="preserve">	<span class="italic">feststellend</span>, dass sich die Konfliktdynamik in Kolumbien verändert, und <span class="italic">betonend</span>, wie wichtig es ist, die Präsenz des Staates und die Raumentwicklung in allen vom Konflikt betroffenen Regionen zu stärken, so auch durch die Durchführung des Endgültigen Abkommens, durch ergänzende Sicherheitsmaßnahmen und durch Anstrengungen zur Bewältigung der unerlaubten Drogenproduktion und des unerlaubten Drogenhandels sowie des unerlaubten Bergbaus,</p>
      </container>
      <container name="in Anerkennung" eId="container_7">
        <p xml:space="preserve">	<span class="italic">in Anerkennung</span> der Entschlossenheit der Regierung, die territoriale Kontrolle des Staates wiederherzustellen und die Präsenz des Staates in allen Gebieten auszubauen, und <span class="italic">unterstreichend</span>, wie wichtig es ist, dass die Verifikationsmission der Vereinten Nationen vor Ort präsent ist, insbesondere in von Konflikten betroffenen Regionen, um die Zusammenarbeit mit den Behörden und diesen Gemeinschaften zu unterstützen,</p>
      </container>
      <container name="in Bekräftigung" eId="container_8">
        <p xml:space="preserve">	<span class="italic">in Bekräftigung</span> der souveränen Eigenverantwortung Kolumbiens für die Durchführung des Endgültigen Abkommens,</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_9" class="SingleTxt">
        <num>1.</num>
        <content eId="para_9__content">
          <p xml:space="preserve">	<span class="italic">beschließt</span>, das Mandat der Verifikationsmission der Vereinten Nationen in Kolumbien bis zum 31. Oktober 2027 zu verlängern, dessen Schwerpunkt auf ihrer Hauptaufgabe der Unterstützung der Verifikation und der Überwachung der Durchführung des Endgültigen Abkommens nach Resolution <a href="https://docs.un.org/ot/S/RES/2366(2017)">2366 (2017)</a> liegen soll;</p>
        </content>
      </paragraph>
      <paragraph eId="para_10" class="SingleTxt">
        <num>2.</num>
        <content eId="para_10__content">
          <p xml:space="preserve">	<span class="italic">ersucht</span> den Generalsekretär, Koordinierung und Effizienzgewinne zu gewährleisten, indem er unter anderem dafür sorgt, dass andere Tätigkeiten in dem Land von der Institution des Systems der Vereinten Nationen ausgeführt werden, die dafür am besten geeignet ist;</p>
        </content>
      </paragraph>
      <paragraph eId="para_12" class="SingleTxt">
        <num>3.</num>
        <content eId="para_12__content">
          <p xml:space="preserve">	<span class="italic">bekundet </span>seine Bereitschaft, auch weiterhin mit Kolumbien zusammenzuarbeiten.</p>
        </content>
      </paragraph>
    </mainBody>
  </statement>
